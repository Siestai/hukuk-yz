{
  "name": "@hukuk/web-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api/schema": "./src/api/schema.d.ts",
    "./api/*": "./src/api/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./i18n/*": "./src/i18n/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./test/setup": "./src/test/setup.ts",
    "./messages/tr.json": "./messages/tr.json"
  },
  "scripts": {
    "lint": "eslint --config ../../services/dashboard-web/eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:types": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@hukuk/ui": "workspace:*",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
