# Copy to .env (gitignored). `make up` does this automatically if .env is missing.
ENV=dev
LOG_LEVEL=INFO

# Postgres (used by the compose postgres service)
POSTGRES_USER=hukuk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hukuk

# Host port of the compose postgres; change it (and DATABASE_URL below) if 5432 is taken.
POSTGRES_HOST_PORT=5432

# For running the app on the host (uv run); compose overrides the host with `postgres`.
DATABASE_URL=postgresql+asyncpg://hukuk:change-me@localhost:5432/hukuk

# Official-source verification (python -m app.verification; task 06). Nothing is sent unless LIVE=1.
# Goes into the User-Agent so the sites can reach us; required for live runs.
VERIFY_CONTACT=
# Seconds between two requests to one source; below 10 is refused.
VERIFY_MIN_INTERVAL_SECONDS=12
# Raw official answers (gitignored with data/); absolute path. Default: <repo>/data/official.
# VERIFY_CACHE_DIR=/abs/path/to/data/official
# Optional outbound proxy per source; none by default. karararama.yargitay.gov.tr is unreachable
# from the VPS, so it usually needs one (Turkish egress) or a run from another machine.
# VERIFY_PROXY_YARGITAY=http://proxy.example:3128
# VERIFY_PROXY_EMSAL=
# VERIFY_PROXY_AYM=
# VERIFY_PROXY_DANISTAY=

# Sessions (task 08). Fixed lifetime in hours; the cookie is Secure unless set to false (plain-http dev).
# LOCAL DEV over http://localhost MUST set COOKIE_SECURE=false, or the browser drops the cookie and
# login "succeeds" but loops back to /giris. `make dev` sets it in a fresh .env and refuses to start
# if it is still true. Production keeps true (TLS ends at the reverse proxy).
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# Login rate limit (task 10a): failed attempts inside the window that block further logins (429).
LOGIN_MAX_FAILS_PER_EMAIL=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated); empty = none.
# Production MUST set it to the dashboard-web / reverse-proxy network (address or CIDR, never
# `*`), and dashboard-web must forward the browser IP in X-Forwarded-For (task 10b). Empty, the
# per-IP login limit sees only the proxy address, so everyone shares one counter (a WARNING is
# logged at startup when ENV is not dev).
FORWARDED_ALLOW_IPS=

# Decision PDFs (task 10a): absolute path of the Drive copy that ingest_file.path is relative to
# (data/drive); mount it read-only. Unset: GET /review/decisions/{id}/file answers 404.
# ARCHIVE_ROOT=/abs/path/to/data/drive
# ARCHIVE_MAX_FILE_BYTES=52428800
# Compose (task 10d): the host directory mounted read-only at /archive in the app container, which
# sets ARCHIVE_ROOT=/archive itself. Relative paths are relative to infra/compose/. Default: the
# Drive copy. `make demo-data` switches it to the synthetic demo archive, `make load-archive` back
# (infra/demo/README.md).
# ARCHIVE_HOST_DIR=../../data/drive

# Uploaded files (task 12): absolute path of the file store (a Docker volume in compose, which sets
# FILE_STORE_ROOT=/filestore itself). Unset: the /files upload endpoints answer 503 and the worker
# scans nothing. FILE_MAX_BYTES is the largest upload.
# FILE_STORE_ROOT=/abs/path/to/filestore
# FILE_MAX_BYTES=52428800
# The language-model fallback of the upload detection (task 13a): asked only for the fields the
# rules left empty, with the first 2 pages (6,000 characters) of text and the file name. Off
# until the provider and region are decided (docs/architecture.md); without a key it is skipped.
# FILE_DETECT_LLM_PROVIDER=none
# FILE_DETECT_LLM_MODEL=claude-haiku-4-5-20251001
# FILE_DETECT_LLM_API_KEY=
# FILE_DETECT_LLM_BASE_URL=https://api.anthropic.com
# FILE_DETECT_LLM_TIMEOUT_SECONDS=30

# dashboard-web (task 10b): where the BFF proxy and server components reach `app`. Server-side
# only, required at startup. Local dev: http://localhost:8000 (set COOKIE_SECURE=false above, the
# browser drops a Secure cookie on plain http).
APP_API_URL=http://localhost:8000
# Number of proxies in front of dashboard-web that append to X-Forwarded-For. The client address is
# the entry that many places from the right (1 = the last, added by the single edge proxy);
# entries to its left come from the client and are ignored. Positive integer, invalid = startup error.
# TRUSTED_PROXY_HOPS=1
# Compose passes TRUSTED_PROXY_HOPS (default 1) to dashboard-web and sets its APP_API_URL to
# http://app:8000 itself; the APP_API_URL above is for `make web-dev` (pnpm on the host).
# Host port of the compose dashboard-web; change it if 3000 is taken.
DASHBOARD_HOST_PORT=3000
