{
  "name": "hukuk-yz",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format:check": "prettier --check services/dashboard-web services/web packages/ui packages/web-core",
    "openapi": "uv run python -m app.openapi > packages/web-core/openapi.json && pnpm --filter @hukuk/web-core openapi:types"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
